{
  "appId": "com.muhe.fit",
  "appName": "沐禾健身",
  "webDir": "launcher",
  "backgroundColor": "#0c0e12",
  "android": {
    "allowMixedContent": true
  },
  "server": {
    "allowNavigation": ["*"]
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "disable"
    },
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "launchFadeOutDuration": 180,
      "backgroundColor": "#0c0e12",
      "showSpinner": false
    }
  }
}