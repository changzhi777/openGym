# Exercise media downloaded by installs before v1.4.0 (now in catalogue/media); kept ignored so an
# old folder never gets committed by accident
media/img/
media/gif/

# Runtime data — users, passkeys, per-user state, session secret (root-anchored:
# a bare data/ once swallowed backend-go/internal/data/ — never commit that package by accident)
/data/

# Local config
.env

# Build output / deps
frontend/dist/
node_modules/
*.log
.DS_Store
node_modules
.claude/
.agents/
.superpowers/

# Nix build result symlinks
result
result-*

# CI reports (test:* jobs write these next to the suites)
junit.xml
coverage/
test-results.json
test-results.jsonl
lcov.info
/stats/
frontend/bundle-size.json

# Local planning notes
docs/superpowers/plans/

# fork: local tooling / plan artifacts (nothing here belongs upstream)
.zcf/
.serena/
.spec-workflow/
.playwright-mcp/

# fork backend-go
backend-go/muhe-api

# Android Studio
frontend/android/.idea/
# Python and Kotlin build leftovers (scripts/, the Android build)
__pycache__/
*.pyc
.kotlin/

# The maintainer's brand material (logo variants, merch, Buy Me a Coffee covers) sits next to the
# tracked banner and screenshots but is not part of the repository; keep it out of a `git add -A`
assets/logo/
assets/merch/
assets/tee/
assets/bmc-cover*
# scripts/pdf/render-samples.mjs output (npm run pdf:check)
frontend/pdf-samples/

# fork(W1): dev-only API target switch file (dev-api-switcher.mjs)
frontend/.dev-api-target

# W1 双后端切换开关(本机环境值,勿入库)
frontend/.dev-api-target
backend-go/.dev-api-target
